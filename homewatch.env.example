# Copy to homewatch.env and fill in real values. Never commit homewatch.env.
# Loaded via systemd EnvironmentFile= — see homewatch.service.

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Admin login
AUTH_USERNAME=
# Generate with: python3 -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your-password'))"
AUTH_PASSWORD_HASH=

# Email alerts (optional — leave blank to disable)
SMTP_FROM=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# Push alerts via ntfy.sh (optional — leave blank to disable)
NTFY_TOPIC=
